# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Settings › Environment Variables).
# Nunca commite valores reais.

# URL canônica do site (sitemap, Open Graph, JSON-LD). Confirmar o domínio oficial.
NEXT_PUBLIC_SITE_URL=https://spacgestao.com

# "true" SOMENTE em produção aprovada. Qualquer outro valor mantém noindex + robots Disallow.
NEXT_PUBLIC_ALLOW_INDEXING=false

# "true" exibe os selos internos ("Conteúdo a validar", "Foto a fornecer"...). Use só em ambiente de Preview.
NEXT_PUBLIC_SHOW_PENDING=false

# Opcionais — exibidos no rodapé/contato apenas se preenchidos.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=

# Envio do formulário (Resend — https://resend.com). As três são obrigatórias para ativar o envio.
RESEND_API_KEY=
# Destinatário(s) dos contatos, separados por vírgula
CONTACT_TO_EMAIL=
# Remetente verificado no Resend, ex.: "Site SPAC <site@spacgestao.com>"
CONTACT_FROM_EMAIL=
