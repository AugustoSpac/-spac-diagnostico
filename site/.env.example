# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Settings › Environment Variables).
# Nunca commite valores reais.

# URL canônica do site (sitemap, Open Graph, JSON-LD). Confirmar o domínio oficial.
NEXT_PUBLIC_SITE_URL=https://www.spacgestao.com

# "true" SOMENTE em produção aprovada. Qualquer outro valor mantém noindex + robots Disallow.
NEXT_PUBLIC_ALLOW_INDEXING=false

# "true" exibe os selos internos ("Conteúdo a validar", "Foto a fornecer"...). Use só em ambiente de Preview.
NEXT_PUBLIC_SHOW_PENDING=false

# Opcionais. O e-mail comercial padrão é contato@spacgestao.com (rodapé, contato e destino do formulário).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=

# Envio do formulário (Resend — https://resend.com). Só a chave é obrigatória para ativar.
RESEND_API_KEY=
# Opcional: destinatário(s), separados por vírgula. Padrão: o e-mail comercial acima.
CONTACT_TO_EMAIL=
# Opcional: remetente. Padrão "Site SPAC <onboarding@resend.dev>", que só entrega para o
# e-mail dono da conta Resend. Com o domínio verificado na Resend, use "Site SPAC <site@spacgestao.com>".
CONTACT_FROM_EMAIL=
